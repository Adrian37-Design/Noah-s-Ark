{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "*.html",
          "*.css",
          "*.js",
          "*.png",
          "*.jpg",
          "*.jpeg",
          "*.svg",
          "*.ico",
          "*.woff",
          "*.woff2",
          "*.ttf",
          "*.gif",
          "*.webp"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/rollover",
      "schedule": "59 21 * * 6"
    }
  ]
}
